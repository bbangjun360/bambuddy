COMPOSE_PROJECT_NAME=farm_harness

# Set immutable version@digest references before use.
POSTGRES_IMAGE=postgres:REPLACE@sha256:REPLACE
PYTHON_IMAGE=python:REPLACE-slim@sha256:REPLACE
ORCA_IMAGE=ghcr.io/REPLACE/orca-slicer-api:REPLACE@sha256:REPLACE

POSTGRES_DB=bambuddy
POSTGRES_USER=bambuddy
POSTGRES_PASSWORD=local-harness-only
BAMBUDDY_PORT=18000
MOCK_PORT=19099

# Discovered and confirmed during WP-000.
BAMBUDDY_HEALTH_URL=http://127.0.0.1:18000/
MOCK_HEALTH_URL=http://127.0.0.1:19099/health
